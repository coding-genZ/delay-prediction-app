# AWS (all optional — app runs fully local without these)
S3_MODEL_BUCKET=
S3_MODEL_KEY=models/catboost_delay_model.cbm
S3_CONFIG_KEY=models/model_info.json
DYNAMODB_PREDICTIONS_TABLE=shipment-delay-predictions
CLOUDWATCH_LOG_GROUP=/shipment-delay/api
AWS_REGION=us-east-1

# Live weather enrichment (optional, free tier at openweathermap.org)
OPENWEATHER_API_KEY=

# Point Streamlit at a remote API instead of localhost (optional)
API_BASE_URL=http://127.0.0.1:8000
